 aiter/ops/attention.py                        |  76 +++++++
 csrc/py_itfs_cu/asm_mtp_verify_attn.cu        | 206 ++++++++++++++++++
 .../mtp_verify_attn/vattn_hd256_fp8_gqa16.co  | Bin 0 -> 16128 bytes
 .../mtp_verify_attn/vattn_hd256_fp8_gqa8.co   | Bin 0 -> 16192 bytes
 hsa/gfx950/mtp_verify_attn/vattn_reduce.co    | Bin 0 -> 7720 bytes
 op_tests/test_mtp_verify_attn_asm.py          | 126 +++++++++++
 7 files changed, 419 insertions(+)
 create mode 100644 csrc/py_itfs_cu/asm_mtp_verify_attn.cu
 create mode 100755 hsa/gfx950/mtp_verify_attn/vattn_hd256_fp8_gqa16.co
 create mode 100755 hsa/gfx950/mtp_verify_attn/vattn_hd256_fp8_gqa8.co
 create mode 100755 hsa/gfx950/mtp_verify_attn/vattn_reduce.co
