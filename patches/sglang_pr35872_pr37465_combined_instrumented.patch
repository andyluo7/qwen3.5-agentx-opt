                             logits_output.next_token_logits,
                             forward_batch.positions,
@@ -1021,6 +1026,16 @@ class EagleDraftWorker(EagleDraftWorkerBase):
                 draft_logits_output.next_token_logits,
                 batch.sampling_info.temperatures,
             )
+        elif self.topk == 1 and _is_hip:
+            logger.info_once(
+                "EAGLE_TOPK1_BACKEND phase=draft_extend "
+                "backend=triton_split_argmax"
+            )
+            ret_topk_p, ret_topk_index = draft_topk1_postprocess(
+                draft_logits_output.next_token_logits,
+                positions=None,
+            )
+            ret_draft_probs = None
         elif self.topk == 1 and not _is_hip:
             # Gated to CUDA: see #26358 — ROCm's argmax tie-break corrupts
